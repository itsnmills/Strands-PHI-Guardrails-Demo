# Strands PHI Guardrails Demo — Environment Variables
# Copy this file to .env and fill in your values

# DeepSeek V4 Flash via OpenCode Go (default)
OPENCODE_GO_API_KEY=your_opencode_go_key_here
# PHI_MODEL=deepseek-v4-flash
# PHI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional fallback
# OPENROUTER_API_KEY=your_openrouter_api_key_here
