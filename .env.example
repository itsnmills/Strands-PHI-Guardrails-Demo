# Strands PHI Guardrails Demo — Environment Variables
# Copy this file to .env and fill in your values

# LLM gateway — the demo uses an OpenAI-compatible endpoint.
# Default: OpenCode Go (https://opencode.ai/docs/go) — $10/mo subscription, key from OpenCode sign-in
OPENCODE_API_KEY=your_opencode_go_key_here

# Optional overrides (defaults shown)
# PHI_DEMO_MODEL=glm-5.3-flash
# PHI_DEMO_BASE_URL=https://opencode.ai/zen/go/v1
#
# Other working combos:
#   DeepSeek V4 Flash on Go:  PHI_DEMO_MODEL=deepseek-v4-flash
#   OpenRouter instead:       set OPENROUTER_API_KEY and PHI_DEMO_BASE_URL=https://openrouter.ai/api/v1
